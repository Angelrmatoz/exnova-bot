# Credenciales Exnova (nunca commitear .env real)
EXNOVA_EMAIL=
EXNOVA_PASSWORD=

# PRACTICE | REAL — la cuenta la elige el usuario en el CLI (default DEMO).
# Este valor es el default solo cuando se opera sin menú interactivo.
EXNOVA_ACCOUNT_TYPE=PRACTICE

# Credenciales de IQ Option (nunca commitear .env real)
# El ssid se obtiene de la cookie del navegador tras loguearse en iqoption.com
IQ_OPTION_SSID=
IQ_OPTION_EMAIL=
IQ_OPTION_PASSWORD=

#  PRACTICE | REAL — misma regla: la elige el usuario en el CLI (default DEMO).
IQ_OPTION_ACCOUNT_TYPE=PRACTICE

# No usados aún; aquí para fases tardías
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=